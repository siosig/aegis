{
  "name": "@fuwasegu/aegis",
  "version": "1.1.0",
  "description": "DAG-based deterministic context compiler for AI coding agents",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "main": "dist/main.js",
  "bin": {
    "aegis": "dist/main.js"
  },
  "files": [
    "dist/",
    "templates/",
    "skills/",
    "README.md",
    "README.ja.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/main.js",
    "start:agent": "node dist/main.js --surface agent",
    "start:admin": "node dist/main.js --surface admin",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "check": "tsc --noEmit && biome check src/"
  },
  "keywords": [
    "mcp",
    "ai-agent",
    "architecture",
    "context-compiler",
    "dag"
  ],
  "author": "fuwasegu",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuwasegu/aegis.git"
  },
  "homepage": "https://github.com/fuwasegu/aegis#readme",
  "bugs": {
    "url": "https://github.com/fuwasegu/aegis/issues"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "sql.js": "^1.15.2",
    "js-yaml": "^5.5.0",
    "picomatch": "^4.0.7",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
